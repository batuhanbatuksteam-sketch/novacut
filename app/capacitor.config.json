{
  "appId": "tr.com.novacut.berber",
  "appName": "Nova Cut Berber",
  "webDir": "www",
  "backgroundColor": "#0b0a08",
  "ios": {
    "backgroundColor": "#0b0a08",
    "contentInset": "never"
  },
  "android": {
    "backgroundColor": "#0b0a08"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "backgroundColor": "#0b0a08",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchShowDuration": 600
    }
  }
}
